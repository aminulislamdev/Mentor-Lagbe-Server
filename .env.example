# Server configuration — copy to .env and fill in the real values.
# Never commit .env.

PORT=8000
CLIENT_URL=http://localhost:3000

# MongoDB Atlas. The database name is pinned separately so a URI without a
# path segment cannot fall back to the default "test" database.
MONGODB_URI=mongodb://<user>:<password>@<host1>,<host2>,<host3>/?ssl=true&replicaSet=<set>&authSource=admin
MONGODB_DB=mentorlagbe

# BetterAuth JWT verification (the client app serves the JWKS).
JWKS_URL=http://localhost:3000/api/auth/jwks
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=http://localhost:3000

# ImgBB — server-side uploads, so the key never reaches the browser.
# Without a key POST /api/upload answers 503.
IMGBB_API_KEY=
# Optional: point at tests/imgbb-stub.mjs for local testing.
# IMGBB_API_URL=http://127.0.0.1:3100/upload

# Added when the Stripe routes land (payment task):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
